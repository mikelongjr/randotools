# Copy to /opt/open-notebook/.env and fill in secrets.
# NEVER commit a filled .env.

OPEN_NOTEBOOK_ENCRYPTION_KEY=change-me-long-random-string
OPEN_NOTEBOOK_PASSWORD=change-me-strong-password
SURREAL_USER=opennotebook
SURREAL_PASSWORD=change-me-db-password

# Filled automatically by scripts/render-compose.sh / install
TAILSCALE_IP=
