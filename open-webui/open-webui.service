[Unit]
Description=Open WebUI (omenboy) via podman-compose
After=network-online.target open-notebook.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/open-webui
ExecStart=/usr/bin/podman-compose --env-file /opt/open-webui/.env up -d
ExecStop=/usr/bin/podman-compose --env-file /opt/open-webui/.env stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
